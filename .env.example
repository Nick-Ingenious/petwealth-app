# ── Database ───────────────────────────────────────────────────────────
# Local: `pnpm db:up` starts Postgres on 54329. Vercel: injected by the Neon integration.
DATABASE_URL=postgres://petwealth:petwealth@localhost:54329/petwealth

# ── Staff auth (Clerk instance A — Google sign-in only) ────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated email domains allowed to sign in to the admin portal.
STAFF_ALLOWED_EMAIL_DOMAINS=petwealth.com

# ── Shopify (orders/paid + orders/cancelled webhooks → /api/webhooks/shopify) ──
# Webhook signing secret from the Shopify app (Settings → Notifications → Webhooks, or the custom app).
SHOPIFY_WEBHOOK_SECRET=
# The store's permanent domain, e.g. petwealth.myshopify.com. Deliveries from other shops are rejected.
SHOPIFY_SHOP_DOMAIN=
# Accept Shopify test orders? Defaults to true everywhere except Vercel production.
SHOPIFY_ACCEPT_TEST_ORDERS=
# SMS opt-in for new customers: marketing_consent (default — only if they ticked SMS at checkout) | checkout_phone
SHOPIFY_SMS_CONSENT_MODE=

# ── Local development only ─────────────────────────────────────────────
# Signs every request in as this seeded staff user WITHOUT Clerk.
# Ignored unless NODE_ENV=development and the app is not running on Vercel.
AUTH_DEV_BYPASS_EMAIL=

# ── Seed ───────────────────────────────────────────────────────────────
SEED_SUPER_ADMIN_EMAIL=admin@petwealth.com
